# =============================================================================
# AI DataHub Environment Configuration Template
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=aidatahub
POSTGRES_PORT=5432

# Application environment: dev / stage / prod
APP_ENV=dev

# Database URLs per environment
DATABASE_URL_DEV=postgresql://postgres:your-secure-password-here@localhost:5432/aidatahub_dev?schema=public
DATABASE_URL_STAGE=postgresql://postgres:your-secure-password-here@localhost:5432/aidatahub_stage?schema=public
DATABASE_URL_PROD=postgresql://postgres:your-secure-password-here@localhost:5432/aidatahub?schema=public

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=
CACHE_BACKEND=memory

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_BUS_BACKEND=memory
EVENT_BUS_EXCHANGE=aidatahub.events

# MinIO (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# API Gateway
GATEWAY_PORT=3000

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string (at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-me-at-least-32-characters
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Encryption (Security Service)
# -----------------------------------------------------------------------------
# IMPORTANT: 32-character encryption key for sensitive data
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-32-chars-minimum

# -----------------------------------------------------------------------------
# Internal Service URLs (Docker network)
# -----------------------------------------------------------------------------
# These URLs are for inter-service communication within Docker network
AUTH_SERVICE_URL=http://auth-service:4001
METADATA_SERVICE_URL=http://metadata-service:4002
DATA_SERVICE_URL=http://data-service:4003
OPS_SERVICE_URL=http://ops-service:3001
INTEGRATION_SERVICE_URL=http://integration-service:3002
ADMIN_SERVICE_URL=http://admin-service:3003
SHARING_SERVICE_URL=http://sharing-service:3004
ANALYTICS_SERVICE_URL=http://analytics-service:3005
SECURITY_SERVICE_URL=http://security-service:3006
TASK_SERVICE_URL=http://task-scheduler:5001

# -----------------------------------------------------------------------------
# External Integrations (Optional)
# -----------------------------------------------------------------------------
# SMTP for notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password

# DingTalk webhook
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# WeChat Work webhook
# WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# ENABLE_SWAGGER=true
# ENABLE_METRICS=true
# ENABLE_TRACING=true