{
  "name": "@ai-datahub/security-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI DataHub security domain service (data-security + data-lifecycle)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --enable-source-maps dist/main.cjs",
    "build": "tsup",
    "build:check": "tsc -p tsconfig.json --noEmit",
