    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-datahub/contract": "0.1.0",
    "@ai-datahub/shared": "0.1.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "fastify": "^4.26.0",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.17",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
