{
  "name": "@ai-datahub/system-auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI DataHub system-auth - unified authentication and approval framework (NestJS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --enable-source-maps dist/main.js",
    "start": "node --env-file=.env --enable-source-maps dist/main.js",
    "build": "tsup",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-datahub/contract": "0.1.0",
    "@ai-datahub/database": "0.1.0",
    "@ai-datahub/shared": "0.1.0",
    "@casl/ability": "^6.5.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@fastify/static": "^7.0.0",
    "@nestjs/testing": "^10.3.0",
    "@swc/core": "^1.15.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
