{
  "name": "@ai-datahub/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AI DataHub API Gateway - unified entrypoint with routing, CORS, and traceId propagation (NestJS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --enable-source-maps dist/main.js",
    "start": "node --env-file=.env --enable-source-maps dist/main.js",
    "build": "tsup",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-datahub/contract": "0.1.0",
    "@ai-datahub/shared": "0.1.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "fastify": "^4.26.0",
    "http-proxy": "^1.18.1",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@fastify/static": "^7.0.0",
    "@nestjs/testing": "^11.1.17",
    "@swc/core": "^1.15.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
