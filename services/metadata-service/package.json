{
  "name": "@ai-datahub/metadata-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI DataHub metadata service (NestJS, REST/JSON)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --enable-source-maps dist/main.js",
    "build": "tsup",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-datahub/contract": "0.1.0",
    "@ai-datahub/shared": "0.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "fastify": "^4.26.0",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
