{
  "name": "@ai-datahub/metadata-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI DataHub metadata service (NestJS, REST/JSON)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --enable-source-maps dist/main.cjs",
    "build": "tsup",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-datahub/contract": "0.1.0",
    "@ai-datahub/shared": "0.1.0",
    "@ai-datahub/database": "0.1.0",
    "@casl/ability": "^6.5.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^4.26.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@swc/core": "^1.15.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^1.0.0"
  }
}
