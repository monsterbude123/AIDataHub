{
  "name": "ai-datahub",
  "version": "1.0.0",
  "description": "Modular Data Platform SDK for Node.js/TypeScript",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "concurrently npm:build:contract npm:build:sdk npm:build:shared npm:build:database && concurrently npm:build:auth npm:build:metadata npm:build:data npm:build:tasks npm:build:gateway npm:build:ops npm:build:integration npm:build:admin npm:build:sharing npm:build:analytics npm:build:security",
    "build:contract": "npm -w @ai-datahub/contract run build",
    "build:sdk": "npm -w @ai-datahub/sdk run build",
    "build:shared": "npm -w @ai-datahub/shared run build",
    "build:database": "npm -w @ai-datahub/database run build",
    "build:auth": "npm -w @ai-datahub/system-auth-service run build",
    "build:metadata": "npm -w @ai-datahub/metadata-service run build",
    "build:data": "npm -w @ai-datahub/data-service-service run build",
    "build:tasks": "npm -w @ai-datahub/task-scheduler-service run build",
    "build:gateway": "npm -w @ai-datahub/api-gateway run build",
    "build:ops": "npm -w @ai-datahub/ops-service run build",
    "build:integration": "npm -w @ai-datahub/integration-service run build",
    "build:admin": "npm -w @ai-datahub/admin-service run build",
    "build:sharing": "npm -w @ai-datahub/sharing-service run build",
    "build:analytics": "npm -w @ai-datahub/analytics-service run build",
    "build:security": "npm -w @ai-datahub/security-service run build",
    "build:check": "npm -ws run build:check",
    "test": "npm -ws run test",
    "test:watch": "npm -ws run test:watch",
    "test:contract-scan": "node scripts/m2-contract-sdk-scan.mjs",
    "test:coverage:m2": "npm run test:contract-scan && npm -w @ai-datahub/contract run test:coverage && npm -w @ai-datahub/sdk run test:coverage && npm -w @ai-datahub/shared run test:coverage",
    "smoke": "node scripts/smoke.mjs",
    "test:coverage:services": "node scripts/run-services-coverage.mjs",
    "lint": "npm -ws run lint",
    "lint:fix": "npm -ws run lint:fix",
    "format": "npm -ws run format",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "dev:auth": "npm -w @ai-datahub/system-auth-service run dev",
    "dev:metadata": "npm -w @ai-datahub/metadata-service run dev",
    "dev:data": "npm -w @ai-datahub/data-service-service run dev",
    "dev:tasks": "npm -w @ai-datahub/task-scheduler-service run dev",
    "dev:gateway": "npm -w @ai-datahub/api-gateway run dev",
    "dev:ops": "npm -w @ai-datahub/ops-service run dev",
    "dev:integration": "npm -w @ai-datahub/integration-service run dev",
    "dev:admin": "npm -w @ai-datahub/admin-service run dev",
    "dev:sharing": "npm -w @ai-datahub/sharing-service run dev",
    "dev:analytics": "npm -w @ai-datahub/analytics-service run dev",
    "dev:security": "npm -w @ai-datahub/security-service run dev",
    "start:auth": "npm -w @ai-datahub/system-auth-service run start",
    "start:metadata": "npm -w @ai-datahub/metadata-service run start",
    "start:data": "npm -w @ai-datahub/data-service-service run start",
    "start:gateway": "npm -w @ai-datahub/api-gateway run start",
    "start:tasks": "npm -w @ai-datahub/task-scheduler-service run start",
    "start:ops": "npm -w @ai-datahub/ops-service run start",
    "start:integration": "npm -w @ai-datahub/integration-service run start",
    "start:admin": "npm -w @ai-datahub/admin-service run start",
    "start:sharing": "npm -w @ai-datahub/sharing-service run start",
    "start:analytics": "npm -w @ai-datahub/analytics-service run start",
    "start:security": "npm -w @ai-datahub/security-service run start",
    "dev:all": "node scripts/start-dev.js",
    "dev:all:filtered": "node scripts/start-dev.js",
    "dev:stop": "node scripts/stop-dev.js",
    "dev:status": "node scripts/status-dev.js",
    "dev:setup": "npm run infra:up && npm run build && npm run dev:all",
    "dev:clean": "npm run dev:stop && npm run infra:down",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:status": "docker-compose ps",
    "infra:logs": "docker-compose logs -f",
    "prod:up": "docker-compose -f docker-compose.full.yml up -d --build",
    "prod:down": "docker-compose -f docker-compose.full.yml down",
    "prod:status": "docker-compose -f docker-compose.full.yml ps",
    "prod:logs": "docker-compose -f docker-compose.full.yml logs -f",
    "prod:restart": "npm run prod:down && npm run prod:up",
    "release:sdk:prepare": "node ./scripts/sdk-publish-prepare.mjs --version=1.0.0-alpha.3 --tag=alpha",
    "release:sdk:prepare:beta": "node ./scripts/sdk-publish-prepare.mjs --version=1.0.0-beta.1 --tag=beta",
    "release:sdk:pack": "npm pack --dry-run -w packages/sdk",
    "release:sdk:publish:alpha": "npm publish --tag alpha --access public -w packages/sdk",
    "release:sdk:publish:beta": "npm publish --tag beta --access public -w packages/sdk",
    "release:sdk:publish:latest": "npm publish --tag latest --access public -w packages/sdk"
  },
  "keywords": [
    "data-platform",
    "datahub",
    "sdk",
    "data-governance",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@nestjs/testing": "^11.1.17",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.54.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.3.1",
    "swagger-ui-dist": "^5.32.1",
    "zod": "^3.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
