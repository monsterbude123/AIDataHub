{
  "name": "ai-datahub",
  "version": "1.0.0",
  "description": "Modular Data Platform SDK for Node.js/TypeScript",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm -ws run build",
    "build:check": "npm -ws run build:check",
    "test": "npm -ws run test",
    "test:watch": "npm -ws run test:watch",
    "lint": "npm -ws run lint",
    "lint:fix": "npm -ws run lint:fix",
    "format": "npm -ws run format",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "data-platform",
    "datahub",
    "sdk",
    "data-governance",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "zod": "^3.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
